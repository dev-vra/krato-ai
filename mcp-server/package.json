{
  "name": "@krato-ai/mcp-server",
  "version": "0.1.0",
  "description": "MCP server leve que roda na maquina local do desenvolvedor e expoe terminal/filesystem restrito para o Krato-AI na VPS (via Tailscale).",
  "type": "module",
  "bin": {
    "krato-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
