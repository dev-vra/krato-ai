{
  "name": "krato-ai",
  "version": "0.1.0",
  "description": "Rede multi-agente de IA para desenvolvimento full-stack, com orquestracao hibrida (Ollama local + nuvem), memoria dupla (RAG isolado + aprendizado global) e execucao remota segura.",
  "type": "module",
  "bin": {
    "krato": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "api": "node dist/api/server.js",
    "cli": "node dist/cli.js",
    "dev": "tsx watch src/api/server.ts",
    "dev:cli": "tsx src/cli.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^9.1.1",
    "@types/axios": "^0.9.36",
    "axios": "^1.15.0",
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "grammy": "^1.42.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.0.7",
    "ollama": "^0.5.9",
    "openai": "^4.67.3",
    "p-queue": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
