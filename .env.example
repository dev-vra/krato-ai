# ─── Banco de dados ───────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://kratos:kratos@localhost:5432/kratos

# ─── Busca semântica ──────────────────────────────────────────────
# Modelo de embeddings (sentence-transformers). Se indisponível, o backend
# usa automaticamente um fallback TF-IDF offline (sem download de modelo).
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ─── Credenciais de fontes que exigem cadastro ────────────────────
# Portal da Transparência (CGU) — token gratuito em api.portaldatransparencia.gov.br
PORTAL_TRANSPARENCIA_TOKEN=

# Base dos Dados (BigQuery) — opcional, para a camada tratada
BILLING_PROJECT_ID=

# ─── App ──────────────────────────────────────────────────────────
KRATOS_ENV=development
CORS_ORIGINS=http://localhost:5173
HTTP_TIMEOUT=30
