# ------------------------------------------------------------
# Krato-AI configuration
# ------------------------------------------------------------

# API / Server
PORT=7070
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------
# Ollama (camada local de inferencia na VPS)
# ------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
# Tempo (em segundos ou -1) que um modelo fica quente na RAM.
# Use -1 para manter sempre carregado enquanto a VPS estiver rodando.
OLLAMA_KEEP_ALIVE=-1
# Numero de threads de CPU (sincronize com os nucleos fisicos da VPS).
OLLAMA_NUM_THREAD=6

# Modelos "sweet-spot" para 12GB RAM (escolha quantizacoes 4-bit GGUF).
# Router/Product/Supervisor (raciocinio geral e rapido)
KRATO_MODEL_ROUTER=llama3.1:8b-instruct-q4_K_M
# Codigo (o agente desenvolvedor)
KRATO_MODEL_CODER=qwen2.5-coder:7b-instruct-q4_K_M
# Revisor/QA (modelo independente para evitar vies de confirmacao)
KRATO_MODEL_EVAL=deepseek-coder-v2:lite-q4_K_M
# Embeddings (para o RAG local)
KRATO_MODEL_EMBED=nomic-embed-text
# Modelo alternativo localizado em PT-BR (opcional): mythos / capivara
# KRATO_MODEL_ROUTER=capivara:7b-q4_K_M

# ------------------------------------------------------------
# Nuvem (delegacao para "frontier models" sob demanda)
# ------------------------------------------------------------
# Deixe em branco para desativar a camada de nuvem.
CLOUD_PROVIDER=anthropic            # anthropic | openai | google | ollama-cloud
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=claude-sonnet-4-6
# Heuristicas automaticas para escalar para nuvem
CLOUD_ESCALATE_ON_MULTIMODAL=true
CLOUD_ESCALATE_ON_TOKENS=6000
CLOUD_ESCALATE_ON_FAILURES=2

# ------------------------------------------------------------
# Memoria
# ------------------------------------------------------------
# Armazenamento vetorial (RAG isolado por projeto)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Memoria global persistente (SQLite local, barato e confiavel)
KRATO_DATA_DIR=./data
KRATO_DB_PATH=./data/krato.db

# ------------------------------------------------------------
# MCP / Execucao remota na maquina do desenvolvedor
# ------------------------------------------------------------
# Endereco do MCP server (rodando na maquina local do dev, via Tailscale)
MCP_URL=http://100.64.0.2:8787
MCP_TOKEN=troque-este-token-imediatamente
# Diretorio-alvo (sandbox) na maquina local onde os projetos serao criados
MCP_WORKSPACE=~/workspace/krato-projects
# Exige aprovacao humana (HITL) para comandos destrutivos
MCP_REQUIRE_APPROVAL=true
